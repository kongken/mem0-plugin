  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "kongken",
  "homepage": "https://github.com/kongken/mem0-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongken/mem0-plugin.git"
  },
  "keywords": ["pi-package", "memory", "mem0", "self-hosted", "oss", "semantic-search"],
  "pi": {
    "extensions": ["./pi/extensions/mem0-oss.ts"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --test \"pi/tests/*.test.ts\""
